{
  "name": "@foaf/client",
  "version": "0.1.2",
  "private": true,
  "description": "Shared FOAF auth, contacts, ledger, adapters, and React Native UI",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./contacts": "./src/contacts/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "test": "jest",
    "test:integration": "jest --runInBand --testPathPattern=spec/integration --testPathIgnorePatterns=/node_modules/",
    "typecheck": "tsc --noEmit",
    "check": "npm test -- --runInBand && npm run typecheck"
  },
  "dependencies": {
    "@noble/hashes": "1.3.3",
    "@noble/secp256k1": "1.7.1",
    "axios": "^1.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  }
}
